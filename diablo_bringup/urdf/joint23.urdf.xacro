<?xml version="1.0"?>
<robot name="joint23_bringup" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Argumen (bisa dioverride dari launch file) ============ -->
  <xacro:arg name="port_name" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="1000000"/>

  <!-- ============ Link dasar ============ -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint2_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <link name="joint3_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 1.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ============ Joint ID2 (base -> joint2_link) ============ -->
  <joint name="joint2" type="revolute">
    <parent link="base_link"/>
    <child link="joint2_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- konvensi ros2_control: raw tengah (2048) = 0 rad, range -pi..+pi -->
    <limit lower="-3.1415927" upper="3.1415927" effort="2.0" velocity="4.0"/>
  </joint>

  <!-- ============ Joint ID3 (joint2_link -> joint3_link), serial/rangkai ============ -->
  <joint name="joint3" type="revolute">
    <parent link="joint2_link"/>
    <child link="joint3_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415927" upper="3.1415927" effort="2.0" velocity="4.0"/>
  </joint>

  <!-- ============ ros2_control: 1 hardware system, 2 joint (1 bus/port yang sama) ============ -->
  <ros2_control name="joint23_system" type="system">
    <hardware>
      <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
      <param name="disable_torque_at_init">true</param>
      <param name="port_name">$(arg port_name)</param>
      <param name="baud_rate">$(arg baud_rate)</param>
      <param name="number_of_joints">2</param>
      <param name="number_of_transmissions">2</param>
      <param name="error_timeout_ms">500</param>
      <param name="dynamixel_model_folder">/param/dxl_model</param>
      <param name="transmission_to_joint_matrix">1,0,0,1</param>
      <param name="joint_to_transmission_matrix">1,0,0,1</param>
    </hardware>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <gpio name="dxl2">
      <param name="type">dxl</param>
      <param name="ID">2</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <state_interface name="Present Current"/>
      <param name="Operating Mode">3</param>
      <param name="Position P Gain">800</param>
      <param name="Position I Gain">100</param>
      <param name="Position D Gain">100</param>
    </gpio>

    <gpio name="dxl3">
      <param name="type">dxl</param>
      <param name="ID">3</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <state_interface name="Present Current"/>
      <param name="Operating Mode">3</param>
      <param name="Position P Gain">800</param>
      <param name="Position I Gain">100</param>
      <param name="Position D Gain">100</param>
    </gpio>
  </ros2_control>

</robot>
