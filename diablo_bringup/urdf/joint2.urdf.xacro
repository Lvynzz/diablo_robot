<?xml version="1.0"?>
<robot name="joint2_bringup" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Argumen (bisa dioverride dari launch file) ============ -->
  <xacro:arg name="port_name" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="57600"/>
  <xacro:arg name="use_dummy" default="false"/>

  <!-- ============ Link dasar (dummy, sekedar biar TF valid) ============ -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint2_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ============ Joint yang digerakkan oleh Dynamixel ID 2 ============ -->
  <!-- Nama joint HARUS sama persis dengan yang dipakai di controller yaml & script -->
  <joint name="joint2" type="revolute">
    <parent link="base_link"/>
    <child link="joint2_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- limit dalam radian, mengikuti range fisik motor (0 - 360 derajat) -->
    <limit lower="0.0" upper="6.2831853" effort="2.0" velocity="4.0"/>
  </joint>

  <!-- ============ ros2_control: hubungkan ke dynamixel_hardware_interface ============ -->
  <ros2_control name="joint2_system" type="system">
    <hardware>
      <xacro:if value="$(arg use_dummy)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_dummy)">
        <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
        <param name="port_name">$(arg port_name)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="number_of_joints">1</param>
        <param name="number_of_transmissions">1</param>
        <param name="error_timeout_ms">500</param>
        <param name="dynamixel_model_folder">/param/dxl_model</param>
        <param name="transmission_to_joint_matrix">1</param>
        <param name="joint_to_transmission_matrix">1</param>
      </xacro:unless>
    </hardware>

    <joint name="joint2">
      <param name="id">2</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <xacro:unless value="$(arg use_dummy)">
      <gpio name="dxl2">
        <param name="type">dxl</param>
        <param name="ID">2</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <param name="Operating Mode">3</param>
        <param name="Position P Gain">800</param>
        <param name="Position I Gain">100</param>
        <param name="Position D Gain">100</param>
      </gpio>
    </xacro:unless>
  </ros2_control>

</robot>
