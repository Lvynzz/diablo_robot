<robot name="diablo_full_body" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="prefix" default=""/>
<!-- Set true to publish only the torso, head and upper-body manipulators. -->
<xacro:arg name="upper_only" default="false"/>
<!-- Keep the existing mock default for RViz/MoveIt-only use.  Hardware
     launch files explicitly pass use_mock_hardware:=false. -->
<xacro:arg name="use_mock_hardware" default="true"/>
<xacro:arg name="enable_base_hardware" default="true"/>
<xacro:arg name="enable_arm_hardware" default="true"/>
<xacro:arg name="arm_port_name" default="/dev/ttyUSB1"/>
<xacro:arg name="hand_port_name" default="/dev/ttyUSB2"/>
<xacro:arg name="baud_rate" default="1000000"/>
<xacro:arg name="wheel_radius" default="0.105"/>
<xacro:arg name="track_width" default="0.3751"/>

<!-- One GPIO description is shared by the arm and Seed Robotics hand
     ros2_control systems below.  The IDs are kept next to the calls so the
     physical bus mapping remains easy to audit. -->
<xacro:macro name="diablo_dynamixel_gpio" params="gpio_name motor_id">
  <gpio name="${gpio_name}">
    <param name="type">dxl</param>
    <param name="ID">${motor_id}</param>
    <command_interface name="Goal Position"/>
    <state_interface name="Present Position"/>
    <state_interface name="Present Velocity"/>
    <state_interface name="Present Current"/>
    <param name="Operating Mode">3</param>
    <param name="Position P Gain">800</param>
    <param name="Position I Gain">100</param>
    <param name="Position D Gain">100</param>
  </gpio>
</xacro:macro>

